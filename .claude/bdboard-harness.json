{
  "version": 1,
  "verify": "npm run verify",
  "prFlow": "pr",
  "mainBranch": "main",
  "alwaysOnServer": {
    "port": 8787,
    "restartScript": "scripts/always-on-server.sh"
  },
  "merge": {
    "mode": "S2",
    "leaseMinutes": 8,
    "slotWaitMinutes": 10,
    "statusContext": "bdboard/landed-verify"
  },
  "hooks": {
    "denyBashPatterns": [
      "\\bnpm run verify:steps\\b",
      "bd[[:space:]]+dolt[[:space:]]+(push|pull)([[:space:]].*)?--remote([[:space:]]+|=)origin([[:space:]]|$)"
    ],
    "denyBashMessages": [
      "verify:steps はラッパー内部の入口です。npm run verify を使ってください（スロットとプロセスグループ kill を素通りします）",
      "origin は公開 remote なので Dolt の push/pull に使わない。"
    ]
  },
  "models": {
    "routes": {
      "implement": {
        "low": ["codex:gpt-6-luna", "claude:sonnet"],
        "med": ["codex:gpt-6-luna", "claude:sonnet"],
        "high": ["claude:opus", "codex:gpt-5.6-sol"]
      },
      "review": {
        "*": ["claude:opus"]
      },
      "check": {
        "*": ["claude:fable", "claude:opus"]
      },
      "skill": {
        "*": ["claude:fable", "claude:opus"]
      }
    }
  }
}
