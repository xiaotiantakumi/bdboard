{
  "version": 1,
  "verify": "npm run verify",
  "prFlow": "pr",
  "mainBranch": "main",
  "hooks": {
    "denyBashPatterns": [
      "\\bnpm run verify:steps\\b",
      "bd[[:space:]]+dolt[[:space:]]+(push|pull)([[:space:]].*)?--remote([[:space:]]+|=)origin([[:space:]]|$)"
    ],
    "denyBashMessages": [
      "verify:steps はラッパー内部の入口です。npm run verify を使ってください（スロットとプロセスグループ kill を素通りします）",
      "origin は公開 remote なので Dolt の push/pull に使わない。"
    ]
  },
  "models": {
    "routes": {
      "implement": {
        "low": ["codex:gpt-5.6-luna", "cursor:composer-2.5-fast", "claude:haiku"],
        "med": ["codex:gpt-5.6-terra", "cursor:composer-2.5", "claude:sonnet"],
        "high": ["claude:opus", "codex:gpt-5.6-sol"]
      },
      "review": {
        "*": ["claude:opus"]
      },
      "check": {
        "*": ["claude:fable", "claude:opus"]
      },
      "skill": {
        "*": ["claude:fable", "claude:opus"]
      }
    }
  }
}
