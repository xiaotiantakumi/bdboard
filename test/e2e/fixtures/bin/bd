#!/usr/bin/env bash
# Stub `bd` CLI used only by the E2E smoke suite (test/e2e). CI does not
# install the real bd binary (bdboard-3tw.88): this script sits ahead of the
# real `bd` on PATH (see test/e2e/global-setup.ts) and answers the bd list
# shapes the server actually invokes on the request path.
#
# Each call site that hits an unimplemented subcommand already tolerates a
# failing bd call via try/catch — the same way a real bd failure behaves in
# production — so exiting non-zero for unsupported shapes is intentional.
#
# Dispatch is position-based. Before `--`, skip flags. Only five flags consume
# a following token as their value: `-C`, `--limit`, `-l`, `--label`, and
# `--status`. Every other flag before `--` advances by one token only (enough
# for the shapes this stub answers). After `--`, stop flag parsing and treat
# every token as positional. The first positional token is the subcommand; for
# `gate`, the next positional is the gate sub-subcommand.
#
# Supported shapes (see src/infrastructure/bd/bd-cli-*.ts):
#
#   bd --readonly -C <root> list --json --all ... [--include-gates]
#     → BDBOARD_E2E_BD_LIST_FIXTURE (required; golden issue list for the board)
#
#   bd --readonly -C <root> list -l human --json ...
#     → BDBOARD_E2E_BD_HUMAN_LIST_FIXTURE, or `[]` when unset
#
#   bd --readonly -C <root> list --label gt:slot --json ...
#     → BDBOARD_E2E_BD_MERGE_SLOT_FIXTURE, or `[]` when unset
#
#   bd --readonly -C <root> list --status in_progress --json ...
#     → BDBOARD_E2E_BD_LEASE_FIXTURE, or `[]` when unset
#
#   bd --readonly -C <root> gate list --json ...
#     → BDBOARD_E2E_BD_GATE_LIST_FIXTURE, or `[]` when unset
#
# Root-aware empty override (marker file):
#   When `-C <root>` points at a project whose `.beads/e2e-empty-list` exists,
#   every `list` shape (including `--all`) and `gate list` returns `[]` and exits
#   0 — before any required-fixture check. global-setup creates a second scan
#   root (`fixture-project-b`) with that marker so the board has two projects and
#   ChatPanel renders `.chat-project-select` (bdboard-iglk), but the stub cannot
#   scope the golden issue list per root. Without this override the second project
#   would duplicate every ticket (smoke strict-mode violations, doubled hygiene-
#   panel rows). The empty root exists only to bump project count; board content
#   stays identical to the single-project fixture.
#   Marker file instead of env path matching: macOS os.tmpdir() is a symlink
#   (/var → /private/var) so global-setup's path and the realpath the server
#   passes to `-C` never string-match; 14 e2e failures were observed that way.
#
# global-setup (test/e2e/global-setup.ts) sets all five vars: the required
# BDBOARD_E2E_BD_LIST_FIXTURE, BDBOARD_E2E_BD_HUMAN_LIST_FIXTURE (same golden
# file — stale_pending_decision rows in the health panel), and e2e-only fixtures
# under test/e2e/fixtures/bd/ for gate list, in_progress lease scan, and
# merge-slot label list (bdboard-vr71).
#
# Why empty `[]` is the default for human / gate / lease / merge-slot lists:
# BdCliHumanDecisions.listPendingDecisions, BdCliLeaseReader.listInProgressWithLease,
# and BdCliMergeSlotReader.readMergeSlotSignal all throw BdError on a non-zero bd
# exit — none fail-soft. Returning `[]` (or null-equivalent parsing) models
# "nothing pending" without tripping that failure mode. The golden issue list
# fixture remains required because the smoke scenarios have no board to render
# without it.
#
# Every other bd subcommand (show, comments, session-link writes, other writes,
# etc.) exits non-zero on purpose. Those call sites are not exercised by the
# smoke suite, or are reached only when fixture data changes (e.g.
# comment_count > 0). Note that session-link *reads* are not in this group at
# all: they are parsed out of the golden list output's metadata by
# bd-issue-mapper.ts and never shell out to bd.
set -euo pipefail

# Return 0 when `$flag` is immediately followed by `$value` before `--`.
arg_has_pair() {
  local flag="$1"
  local value="$2"
  shift 2
  local prev=""
  for arg in "$@"; do
    if [[ "$arg" == "--" ]]; then
      return 1
    fi
    if [[ "$prev" == "$flag" && "$arg" == "$value" ]]; then
      return 0
    fi
    prev="$arg"
  done
  return 1
}

# Return 0 when `$flag` appears as an exact token before `--`.
arg_has_flag() {
  local flag="$1"
  shift
  for arg in "$@"; do
    if [[ "$arg" == "--" ]]; then
      return 1
    fi
    if [[ "$arg" == "$flag" ]]; then
      return 0
    fi
  done
  return 1
}

emit_optional_fixture() {
  local var_name="$1"
  local fixture_path="${!var_name:-}"
  if [[ -n "$fixture_path" ]]; then
    if [[ ! -f "$fixture_path" ]]; then
      echo "bd stub: fixture not found: $fixture_path" >&2
      exit 1
    fi
    cat "$fixture_path"
  else
    printf '[]\n'
  fi
  exit 0
}

emit_required_fixture() {
  local var_name="$1"
  local fixture_path="${!var_name:-}"
  if [[ -z "$fixture_path" ]]; then
    echo "bd stub: ${var_name} is not set" >&2
    exit 1
  fi
  if [[ ! -f "$fixture_path" ]]; then
    echo "bd stub: fixture not found: $fixture_path" >&2
    exit 1
  fi
  cat "$fixture_path"
  exit 0
}

# Sets global: repo_root (absolute path from `-C`, or empty when absent)
parse_repo_root() {
  repo_root=""
  local -a args=("$@")
  local i=0
  local in_opts=true
  local arg=""
  local prev=""

  while [[ $i -lt ${#args[@]} ]]; do
    arg="${args[$i]}"
    if [[ "$in_opts" == true && "$arg" == "--" ]]; then
      break
    fi

    if [[ "$in_opts" == true ]]; then
      if [[ "$prev" == "-C" ]]; then
        repo_root="$arg"
        return 0
      fi
      case "$arg" in
        -C | --limit | -l | --label | --status)
          prev="$arg"
          i=$((i + 1))
          continue
          ;;
        --readonly | --json | --all | --no-pager | --include-gates)
          prev=""
          i=$((i + 1))
          continue
          ;;
        --*)
          prev=""
          i=$((i + 1))
          continue
          ;;
        -*)
          prev=""
          i=$((i + 1))
          continue
          ;;
      esac
    fi

    prev=""
    i=$((i + 1))
  done
}

# Return 0 when repo_root has the e2e empty-list marker (path-agnostic).
is_empty_root() {
  local root="$1"
  [[ -n "$root" && -f "$root/.beads/e2e-empty-list" ]]
}

# Sets globals: subcommand, sub_subcommand
parse_subcommands() {
  subcommand=""
  sub_subcommand=""
  local -a args=("$@")
  local i=0
  local in_opts=true
  local arg=""

  while [[ $i -lt ${#args[@]} ]]; do
    arg="${args[$i]}"
    if [[ "$in_opts" == true && "$arg" == "--" ]]; then
      in_opts=false
      i=$((i + 1))
      continue
    fi

    if [[ "$in_opts" == true ]]; then
      case "$arg" in
        --readonly | --json | --all | --no-pager | --include-gates)
          i=$((i + 1))
          continue
          ;;
        -C | --limit | -l | --label | --status)
          i=$((i + 2))
          continue
          ;;
        --*)
          i=$((i + 1))
          continue
          ;;
        -*)
          i=$((i + 1))
          continue
          ;;
      esac
    fi

    if [[ -z "$subcommand" ]]; then
      subcommand="$arg"
    elif [[ -z "$sub_subcommand" ]]; then
      sub_subcommand="$arg"
    fi
    i=$((i + 1))
  done
}

parse_repo_root "$@"
parse_subcommands "$@"

if is_empty_root "$repo_root"; then
  if [[ "$subcommand" == "gate" && "$sub_subcommand" == "list" ]]; then
    printf '[]\n'
    exit 0
  fi
  if [[ "$subcommand" == "list" ]]; then
    printf '[]\n'
    exit 0
  fi
fi

if [[ "$subcommand" == "gate" && "$sub_subcommand" == "list" ]]; then
  emit_optional_fixture BDBOARD_E2E_BD_GATE_LIST_FIXTURE
fi

if [[ "$subcommand" == "list" ]]; then
  if arg_has_pair -l human "$@" || arg_has_pair --label human "$@"; then
    emit_optional_fixture BDBOARD_E2E_BD_HUMAN_LIST_FIXTURE
  fi
  if arg_has_pair --label gt:slot "$@"; then
    emit_optional_fixture BDBOARD_E2E_BD_MERGE_SLOT_FIXTURE
  fi
  if arg_has_pair --status in_progress "$@"; then
    emit_optional_fixture BDBOARD_E2E_BD_LEASE_FIXTURE
  fi
  if arg_has_flag --all "$@"; then
    emit_required_fixture BDBOARD_E2E_BD_LIST_FIXTURE
  fi
  echo "bd stub: unsupported list shape: $*" >&2
  exit 1
fi

echo "bd stub: unsupported subcommand (not implemented for e2e): $*" >&2
exit 1
