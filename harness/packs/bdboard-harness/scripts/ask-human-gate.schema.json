{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ask-human-gate.schema.json",
  "title": "ask-human-gate.py --spec",
  "description": "ユーザーの回答待ち (human gate) の質問 spec。この 1 ファイルが --spec の検査と --help の正本。拡張キーワード x-path-exists は「ファイルが実在し空でない」、x-dir-exists は「ディレクトリが実在する」(どちらも相対パスは実行時のカレントディレクトリ基準)、x-labels-unique は「options の label が重複しない」、x-recommend-in-options は「recommend.choice が options の label のどれか、または none。none のとき reason 必須」を意味する (標準の JSON Schema では書けない検査をスクリプトが補う)。",
  "type": "object",
  "additionalProperties": false,
  "required": ["ticket", "decision", "background", "options", "recommend", "resume"],
  "properties": {
    "ticket": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*(\\.[A-Za-z0-9]+)*$",
      "description": "ブロックされる作業チケットの id (例: bdboard-7yfj.2)。"
    },
    "decision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?=[\\s\\S]*\\S)(?:[^\\n]*\\n){0,2}[^\\n]*\\n?$",
      "description": "決めてほしいこと。疑問文で、1〜2 文・300 字・3 行まで。先頭行が gate の title になる。"
    },
    "background": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800,
      "pattern": "^(?=[\\s\\S]*\\S)(?:[^\\n]*\\n){0,3}[^\\n]*\\n?$",
      "description": "背景。なぜこの判断が必要か。2〜4 行・800 字まで。関連ファイル/チケットは id で。"
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "x-labels-unique": true,
      "items": { "$ref": "#/$defs/option" },
      "description": "選択肢 (2〜5 件)。各 {label, consequence} 両方必須 (帰結のない選択肢は拒否)。"
    },
    "recommend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["choice"],
      "x-recommend-in-options": true,
      "properties": {
        "choice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "推奨する選択肢の label (options のどれかと一致)。推奨が無いなら none。"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\n]*$",
          "description": "理由 1 行。choice が none のときは必須 (なぜ推奨が無いかを書く)。"
        }
      },
      "description": "推奨。選んだ label か none を明記する。"
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "screenshots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^\\S(?:[^\\n]*\\S)?\\.(?:png|jpg|jpeg|webp|gif)$",
            "x-path-exists": true
          },
          "description": "スクリーンショットのパス (実在して空でない画像)。本文に載せ、貼り方の案内を添える。"
        },
        "preview_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^https?://\\S+$",
          "description": "プレビュー URL (http/https)。"
        }
      },
      "description": "任意。視覚確認が要るときの導線 (screenshots か preview_url、または両方)。"
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worktree", "steps"],
      "properties": {
        "worktree": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^\\S(?:[^\\n]*\\S)?$",
          "x-dir-exists": true,
          "description": "作業中の worktree のパス (実在するディレクトリ)。"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^[^\\n]*\\S[^\\n]*$"
          },
          "description": "回答後の再開手順 (1 件以上)。選択肢ごとに分岐するなら「A なら〜」と書く。"
        }
      },
      "description": "回答後の再開手順。元のセッションは死んでいる前提で書く。"
    }
  },
  "$defs": {
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "consequence"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[^\\n]*\\S[^\\n]*$",
          "description": "選択肢の名前 (例: A: 案の名前)。"
        },
        "consequence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^[^\\n]*\\S[^\\n]*$",
          "description": "採ったらどうなるか (コスト/リスク)。1 行。"
        }
      }
    }
  }
}
