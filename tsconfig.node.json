{
  // bdboard-u97: vitest の Node 向け設定ファイル用。tsconfig.json (rootDir=src) とは前提が異なるため分離し、build で別 tsc を走らせる。
  // strict 系は tsconfig.base.json に集約 (bdboard-b4o)。ここには前提が違う部分だけを書く。
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"]
  },
  "include": ["vitest.config.ts"]
}
