{
  // bdboard-ruf: vite/vitest の Node 向け設定ファイル用。web/tsconfig.json (DOM/src) とは前提が異なるため分離し、build で別 tsc を走らせる。
  // strict 系は ../tsconfig.base.json に集約 (bdboard-b4o)。ここには前提が違う部分だけを書く。
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "vitest.config.ts"]
}
